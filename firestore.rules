rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDocument(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if ownsUserDocument(userId);
      allow create: if ownsUserDocument(userId)
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email;
      // Email is the lookup key. It must match the authenticated Firebase account and cannot be spoofed.
      allow update: if ownsUserDocument(userId)
        && request.resource.data.id == userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.email == request.auth.token.email;
      allow delete: if ownsUserDocument(userId);
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if ownsUserDocument(userId)
        && request.resource.data.id == userId
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'nickname', 'avatar', 'bio', 'status', 'lastSeen', 'badge'
        ]);
      allow delete: if ownsUserDocument(userId);
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUserId == request.auth.uid
          || resource.data.toUserId == request.auth.uid);
      // Creation and status changes go through authenticated callable functions.
      allow create, update, delete: if false;
    }

    match /searchRateLimits/{userId} {
      allow read, write: if false;
    }
  }
}
